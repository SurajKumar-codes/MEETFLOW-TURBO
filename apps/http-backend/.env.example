# Stream credentials
STREAM_API_KEY=YOUR_STREAM_API_KEY
STREAM_SECRET_KEY=YOUR_STREAM_SECRET_KEY

# Shared secret used to verify the auth JWT minted by the web app.
# Must be identical to BACKEND_JWT_SECRET in apps/web.
BACKEND_JWT_SECRET=YOUR_SHARED_BACKEND_JWT_SECRET

# Port the server listens on.
# Optional locally (defaults to 3001). On Render this is injected
# automatically, so leave it unset there.
PORT=3001

# Comma-separated list of allowed browser origins (CORS).
# Optional locally (defaults to http://localhost:3000,http://localhost:3002).
# In production set this to your frontend URL,
# e.g. https://meetflow-web.onrender.com
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3002

# NOTE: DATABASE_URL is not set here. Prisma Client reads it from
# packages/db/.env at runtime (see packages/db/.env.example). On Render it is
# provided as a service env var, which takes precedence.
